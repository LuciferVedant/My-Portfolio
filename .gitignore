# Root .gitignore for My-Portfolio

node_modules/
.DS_Store
*.log

# Ignore all environment files
.env
.env*
.env.example
*.env

# Backend specific ignored items if run from root
backend/node_modules/
backend/dist/
backend/.env*
backend/data/*.json

# Frontend specific ignored items if run from root
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*
